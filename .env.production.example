# Production Environment Variables Template
# Copy to .env.production and fill in actual values before deployment

# === REQUIRED FOR PRODUCTION (app will fail to start without these) ===

# Environment mode (MUST be "production" to enable security hardening)
ENVIRONMENT=production

# Authentication secret for signing bearer tokens (min 32 chars, must be random)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# Razorpay webhook secret (min 32 chars, used to verify incoming payment webhooks)
# Get from Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Bootstrap admin account (created at first startup)
# Must provide both email and password (min 16 chars)
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=

# Razorpay account ID (links webhooks to merchant)
# Format: acct_XXXXXXXXXXXXXXXX (from Razorpay Dashboard)
BOOTSTRAP_RAZORPAY_ACCOUNT_ID=

# === DATABASE & CACHE ===

# PostgreSQL connection string (provided by Render as DATABASE_URL)
# Format: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# Redis connection string (provided by Render as REDIS_URL)
# Format: redis://default:password@host:6379
REDIS_URL=

# === OPTIONAL: REAL INTEGRATIONS ===

# Live Razorpay credentials (if using real Razorpay, leave blank for simulation)
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=

# Razorpay payment provider mode: 'simulated' (default) or 'live'
PAYMENT_PROVIDER=simulated

# === OPTIONAL: AI PROVIDERS (leave blank to use deterministic agent) ===

# LLM provider: 'deterministic' (default), 'openai', 'anthropic', 'gemini'
LLM_PROVIDER=deterministic

# OpenAI API key (for ChatGPT-powered recovery agent)
OPENAI_API_KEY=

# Anthropic API key (for Claude-powered recovery agent)
ANTHROPIC_API_KEY=

# Google Gemini API key
GEMINI_API_KEY=

# === OPTIONAL: COMMUNICATION PROVIDERS ===

# WhatsApp provider token (e.g., Twilio WhatsApp Business Account)
WHATSAPP_PROVIDER_TOKEN=

# Email provider API key (e.g., SendGrid)
EMAIL_PROVIDER_API_KEY=

# === OPTIONAL: WORKFLOW ENGINE ===

# Enable Temporal for durable async recovery workflows
# If false, recovery actions execute synchronously
TEMPORAL_ENABLED=false

# Temporal server host (if TEMPORAL_ENABLED=true)
# Render doesn't host Temporal; use external service or docker-compose
TEMPORAL_NAMESPACE=default

# === OPTIONAL: MONITORING ===

# Sentry DSN for error reporting
SENTRY_DSN=

# === FRONTEND ===

# Frontend base URL (for CORS and redirects)
# Must match deployed frontend URL (e.g. https://recoverx-web.up.railway.app or https://your-domain.com)
NEXT_PUBLIC_API_URL=https://recoverx-api-production.up.railway.app

# CORS allowed origins (comma-separated, e.g. https://recoverx-web.up.railway.app)
CORS_ORIGINS=https://recoverx-web-production.up.railway.app

# === SESSION & TOKEN SETTINGS ===

# Bearer token lifetime in seconds (default 8 hours = 28800)
ACCESS_TOKEN_TTL_SECONDS=28800

# Payment link expiry in hours (default 72 hours = 3 days)
PAYMENT_LINK_TTL_HOURS=72

# === DEBUG (dev only, never set to true in production) ===

# Debug mode enables detailed error messages and dev tools
DEBUG=false

# Seed demo data on startup (set true for initial demo setup with 1000 customers & 500 cases)
SEED_DEMO_DATA=true

# ========== DEPLOYMENT INSTRUCTIONS ==========
# 
# 1. Generate secure random values:
#    AUTH_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
#    BOOTSTRAP_ADMIN_PASSWORD: Generate a strong 16+ char password
#
# 2. Get Razorpay credentials (or leave blank / use default for simulated provider demo):
#    - RAZORPAY_ACCOUNT_ID: Dashboard → Settings → Account info
#    - RAZORPAY_WEBHOOK_SECRET: Dashboard → Webhooks → Create webhook for /webhooks/razorpay
#
# 3. On Railway / Render:
#    a. Attach PostgreSQL and Redis services (Railway provides DATABASE_URL and REDIS_URL automatically)
#    b. Set environment variables in project settings (do NOT commit .env to git)
#
# 4. First deployment:
#    - Container startup automatically runs: alembic upgrade head
#    - Bootstrap admin will be created with BOOTSTRAP_ADMIN_EMAIL/PASSWORD
#    - If SEED_DEMO_DATA=true, seeds 1000 synthetic customers and 500 coherent cases
#
# 5. Webhook setup (Razorpay Dashboard or Simulated):
#    - Webhook endpoint: POST https://<your-api-url>/webhooks/razorpay
#    - Select events: payment.captured, payment.failed, payment_link.paid, payment_link.expired
#    - Sign with: RAZORPAY_WEBHOOK_SECRET
#
# ========== SECURITY CHECKLIST ==========
# [ ] AUTH_SECRET is 32+ random characters
# [ ] BOOTSTRAP_ADMIN_PASSWORD is 16+ characters and unique
# [ ] RAZORPAY_WEBHOOK_SECRET is from Razorpay Dashboard
# [ ] ENVIRONMENT=production (never development in prod)
# [ ] SEED_DEMO_DATA=false (no synthetic data in production)
# [ ] DEBUG=false
# [ ] No secrets committed to git (use .gitignore)
# [ ] CORS_ORIGINS set to actual frontend URL (not localhost)
# [ ] All *_SECRET and *_KEY values are filled in
# [ ] Database backup is configured (Render default 7 days)
